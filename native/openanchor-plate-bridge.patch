+ObjectID anchor_id(py::handle value)
+{
+    const std::string text = py::cast<std::string>(value);
+    if (text.empty() || !std::all_of(text.begin(), text.end(), [](char c) { return c >= '0' && c <= '9'; }))
+        throw py::value_error("OpenAnchor IDs must be positive decimal strings");
+    const auto id = std::stoull(text);
+    if (id == 0 || id > std::numeric_limits<size_t>::max())
+        throw py::value_error("Invalid OpenAnchor ID");
+    return ObjectID(size_t(id));
+}
+
+TriangleMesh anchor_mesh(const py::dict& data)
+{
+    const auto vertices = data["vertices"].cast<std::vector<std::array<double, 3>>>();
+    const auto triangles = data["triangles"].cast<std::vector<std::array<int, 3>>>();
+    indexed_triangle_set mesh;
+    mesh.vertices.reserve(vertices.size());
+    mesh.indices.reserve(triangles.size());
+    for (const auto& vertex : vertices)
+        mesh.vertices.emplace_back(float(vertex[0]), float(vertex[1]), float(vertex[2]));
+    for (const auto& face : triangles)
+        mesh.indices.emplace_back(face[0], face[1], face[2]);
+    return anchor_plate::checked_mesh(std::move(mesh));
+}
+
+py::dict instance_plate(GUI::Plater& plater, const std::string& object_id, int instance)
+{
+    require_main_thread("instance_plate");
+    const ObjectID id = anchor_id(py::str(object_id));
+    const auto& objects = plater.model().objects;
+    const auto it = std::find_if(objects.begin(), objects.end(), [&](const ModelObject* object) { return object->id() == id; });
+    if (it == objects.end() || instance < 0 || size_t(instance) >= (*it)->instances.size())
+        throw py::value_error("Object or instance changed; refresh the object list");
+    auto& plates = plater.get_partplate_list();
+    const int index = plates.find_instance(int(it - objects.begin()), instance);
+    if (index < 0 || index >= plates.get_plate_count())
+        throw py::value_error("The selected instance does not belong to a plate");
+    const Vec3d origin = plates.get_plate(index)->get_origin();
+    py::dict result;
+    result["index"] = index;
+    result["origin"] = std::array<double, 3>{origin.x(), origin.y(), origin.z()};
+    return result;
+}
+
+void refresh_anchor_object(GUI::Plater& plater, int index)
+{
+    ModelObject& object = *plater.model().objects[index];
+    // ensure_on_bed must not move a sunk or raised original part while refreshing.
+    const bool auto_drop = object.auto_drop;
+    object.auto_drop = false;
+    try {
+        plater.changed_object(index);
+    } catch (...) {
+        object.auto_drop = auto_drop;
+        throw;
+    }
+    object.auto_drop = auto_drop;
+    plater.object_list_changed();
+}
+
+py::dict edit_anchor(GUI::Plater& plater, const py::dict& request, bool restore)
+{
+    require_main_thread(restore ? "restore_anchor" : "apply_anchor");
+    static bool editing = false;
+    if (editing)
+        throw py::value_error("An OpenAnchor edit is already running");
+    struct EditGuard {
+        bool& flag;
+        explicit EditGuard(bool& flag) : flag(flag) { flag = true; }
+        ~EditGuard() { flag = false; }
+    } edit_guard(editing);
+    if (plater.is_loading_project() || plater.inside_snapshot_capture())
+        throw py::value_error("Wait for the current project operation to finish");
+    anchor_plate::Target target;
+    target.object_id = anchor_id(request["object_id"]);
+    target.source_volume_id = anchor_id(request["source_volume_id"]);
+    target.instance = request["instance"].cast<int>();
+    for (py::handle id : request["generated_volume_ids"].cast<py::list>())
+        target.generated_volume_ids.push_back(anchor_id(id));
+    if (!target.generated_volume_ids.empty()) {
+        if (!request.contains("original_extruder") || !request.contains("original_brim"))
+            throw py::value_error("Original OpenAnchor settings are missing; refusing to change the object");
+        if (!request["original_extruder"].is_none())
+            target.original_extruder = request["original_extruder"].cast<std::string>();
+        if (!request["original_brim"].is_none())
+            target.original_brim = request["original_brim"].cast<std::string>();
+    }
+    Model& model = plater.model();
+    const auto it = std::find_if(model.objects.begin(), model.objects.end(), [&](const ModelObject* object) {
+        return object->id() == target.object_id;
+    });
+    if (it == model.objects.end())
+        throw py::value_error("Object was removed; refresh the object list");
+    const int index = int(it - model.objects.begin());
+    int main_slot = 0, anchor_slot = 0;
+    TriangleMesh flange, anchor;
+    if (!restore) {
+        main_slot = request["main_slot"].cast<int>();
+        anchor_slot = request["anchor_slot"].cast<int>();
+        const size_t slots = current_preset_bundle()->filament_presets.size();
+        if (main_slot < 1 || anchor_slot < 1 || size_t(main_slot) > slots || size_t(anchor_slot) > slots)
+            throw py::value_error("Selected filament slot is unavailable");
+        flange = anchor_mesh(request["flange"].cast<py::dict>());
+        anchor = anchor_mesh(request["anchor"].cast<py::dict>());
+    }
+    auto staged = anchor_plate::stage(**it, target, restore, std::move(flange), std::move(anchor), main_slot, anchor_slot);
+    // Allocate the Python result before committing so Python allocation failures leave the model intact.
+    py::dict result;
+    result["object_id"] = std::to_string(staged.record.object_id.id);
+    result["source_volume_id"] = std::to_string(staged.record.source_volume_id.id);
+    py::list generated_ids;
+    for (ObjectID id : staged.record.generated_volume_ids)
+        generated_ids.append(std::to_string(id.id));
+    result["generated_volume_ids"] = generated_ids;
+    result["original_extruder"] = py::cast(staged.record.original_extruder);
+    result["original_brim"] = py::cast(staged.record.original_brim);
+    GUI::ObjectList* object_list = current_app().obj_list();
+    if (object_list == nullptr)
+        throw std::runtime_error("Object list is not available");
+    GUI::Plater::TakeSnapshot snapshot(&plater, GUI::I18N::translate_utf8(restore ? L("Restore original model") : L("Apply OpenAnchor")));
+    anchor_plate::ObjectPtr original(*it);
+    anchor_plate::ModelAccess::attach(*staged.object, &model);
+    *it = staged.object.get();
+    try {
+        object_list->reload_all_plates();
+        refresh_anchor_object(plater, index);
+        save_object_mesh(*staged.object);
+    } catch (...) {
+        *it = original.release();
+        // Rebuild the UI against the restored model if a refresh fails after the pointer swap.
+        object_list->reload_all_plates();
+        refresh_anchor_object(plater, index);
+        throw;
+    }
+    staged.object.release();
+    return result;
+}
