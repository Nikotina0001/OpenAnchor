@@ -0,0 +1,169 @@
+#pragma once
+
+#include <libslic3r/Config.hpp>
+#include <libslic3r/Model.hpp>
+#include <libslic3r/ObjectID.hpp>
+#include <libslic3r/Point.hpp>
+#include <libslic3r/PrintConfig.hpp>
+#include <libslic3r/TriangleMesh.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <map>
+#include <memory>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace Slic3r::anchor_plate {
+
+// Keep ID-preserving copy and destruction scoped to the staged plate edit.
+struct ModelAccess {
+    void operator()(ModelObject* object) const { delete object; }
+    static ModelObject* copy(const ModelObject& source) { return ModelObject::new_copy(source); }
+    static void attach(ModelObject& object, Model* model) { object.set_model(model); }
+};
+using ObjectPtr = std::unique_ptr<ModelObject, ModelAccess>;
+
+struct Target {
+    ObjectID object_id;
+    ObjectID source_volume_id;
+    int instance = 0;
+    std::vector<ObjectID> generated_volume_ids;
+    std::optional<std::string> original_extruder;
+    std::optional<std::string> original_brim;
+};
+
+struct StagedEdit {
+    ObjectPtr object;
+    Target record;
+};
+
+inline TriangleMesh checked_mesh(indexed_triangle_set mesh)
+{
+    if (mesh.vertices.empty() || mesh.indices.empty())
+        throw std::invalid_argument("Anchor mesh is empty");
+    for (const Vec3f& vertex : mesh.vertices)
+        if (!vertex.allFinite())
+            throw std::invalid_argument("Anchor mesh has a non-finite vertex");
+    // Count both incident faces and direction; open, non-manifold and reversed edges are rejected.
+    std::map<std::pair<int, int>, std::pair<int, int>> edges;
+    for (const Vec3i32& face : mesh.indices) {
+        for (int i = 0; i < 3; ++i)
+            if (face[i] < 0 || size_t(face[i]) >= mesh.vertices.size())
+                throw std::invalid_argument("Anchor mesh has an invalid triangle index");
+        const Vec3d a = mesh.vertices[face[0]].cast<double>();
+        const Vec3d b = mesh.vertices[face[1]].cast<double>();
+        const Vec3d c = mesh.vertices[face[2]].cast<double>();
+        if ((b - a).cross(c - a).squaredNorm() == 0.)
+            throw std::invalid_argument("Anchor mesh has a degenerate triangle");
+        for (int i = 0; i < 3; ++i) {
+            int a = face[i], b = face[(i + 1) % 3];
+            auto& edge = edges[{std::min(a, b), std::max(a, b)}];
+            ++edge.first;
+            edge.second += a < b ? 1 : -1;
+        }
+    }
+    for (const auto& entry : edges)
+        if (entry.second.first != 2 || entry.second.second != 0)
+            throw std::invalid_argument("Anchor mesh must be closed and consistently oriented");
+    TriangleMesh result(std::move(mesh));
+    if (!result.stats().manifold() || !std::isfinite(result.volume()) || result.volume() <= 0.f)
+        throw std::invalid_argument("Anchor mesh must have positive enclosed volume");
+    return result;
+}
+
+inline std::optional<std::string> saved_option(const ModelConfig& config, const char* key)
+{
+    const ConfigOption* value = config.option(key);
+    return value == nullptr ? std::nullopt : std::optional<std::string>(value->serialize());
+}
+
+inline void restore_option(ModelConfig& config, const char* key, const std::optional<std::string>& value)
+{
+    if (value) {
+        ConfigSubstitutionContext context{ForwardCompatibilitySubstitutionRule::Disable};
+        config.set_deserialize(key, *value, context);
+    } else
+        config.erase(key);
+}
+
+inline StagedEdit stage(const ModelObject& source, Target target, bool restore,
+                       TriangleMesh flange = {}, TriangleMesh anchor = {}, int main_slot = 0, int anchor_slot = 0)
+{
+    if (source.id() != target.object_id || source.instances.size() != 1 || target.instance != 0)
+        throw std::invalid_argument("Refresh the object list; only objects with one instance can be edited");
+    if (!source.printable || !source.instances.front()->printable)
+        throw std::invalid_argument("Selected object is not printable");
+    const auto source_it = std::find_if(source.volumes.begin(), source.volumes.end(), [&](const ModelVolume* volume) {
+        return volume->id() == target.source_volume_id;
+    });
+    if (source_it == source.volumes.end() || !(*source_it)->is_model_part())
+        throw std::invalid_argument("The original model part has changed; refresh the object list");
+    if (target.generated_volume_ids.empty()) {
+        if (restore || source.volumes.size() != 1)
+            throw std::invalid_argument("Only an original single-part object can receive an anchor");
+        target.original_extruder = saved_option((*source_it)->config, "extruder");
+        target.original_brim = saved_option(source.config, "brim_type");
+    } else {
+        if (target.generated_volume_ids.size() != 2 || source.volumes.size() != 3 ||
+            target.generated_volume_ids[0] == target.generated_volume_ids[1])
+            throw std::invalid_argument("OpenAnchor parts changed; refusing to remove unknown parts");
+        const char* names[] = {"OpenAnchor flange", "OpenAnchor anchor + clamp"};
+        for (size_t i = 0; i < 2; ++i) {
+            const auto it = std::find_if(source.volumes.begin(), source.volumes.end(), [&](const ModelVolume* volume) {
+                return volume->id() == target.generated_volume_ids[i];
+            });
+            if (it == source.volumes.end() || *it == *source_it || (*it)->name != names[i] || !(*it)->is_model_part())
+                throw std::invalid_argument("OpenAnchor parts changed; refusing to remove unknown parts");
+        }
+    }
+    const Transform3d instance_matrix = source.instances.front()->get_transformation().get_matrix();
+    if (!instance_matrix.matrix().allFinite() || std::abs(instance_matrix.linear().determinant()) < 1e-12)
+        throw std::invalid_argument("Object transformation is not invertible");
+    if (!restore) {
+        if (main_slot < 1 || anchor_slot < 1 || main_slot == anchor_slot)
+            throw std::invalid_argument("Choose two different filament slots");
+        // Validate again in object coordinates after float conversion and mirrored transforms.
+        flange.transform(instance_matrix.inverse(), true);
+        anchor.transform(instance_matrix.inverse(), true);
+        flange = checked_mesh(std::move(flange.its));
+        anchor = checked_mesh(std::move(anchor.its));
+    }
+
+    StagedEdit edit{ObjectPtr(ModelAccess::copy(source)), target};
+    ModelAccess::attach(*edit.object, nullptr);
+    edit.object->cut_connectors = source.cut_connectors;
+    edit.object->volume_ids = source.volume_ids;
+    auto& volumes = edit.object->volumes;
+    // delete_volume collapses the last volume's transform and changes its ID; preserve the source exactly.
+    for (auto it = volumes.begin(); it != volumes.end();) {
+        if (std::find(target.generated_volume_ids.begin(), target.generated_volume_ids.end(), (*it)->id()) != target.generated_volume_ids.end()) {
+            delete *it;
+            it = volumes.erase(it);
+        } else
+            ++it;
+    }
+    edit.record.generated_volume_ids.clear();
+    if (restore) {
+        restore_option(volumes.front()->config, "extruder", target.original_extruder);
+        restore_option(edit.object->config, "brim_type", target.original_brim);
+    } else {
+        volumes.front()->config.set_key_value("extruder", new ConfigOptionInt(main_slot));
+        edit.object->config.set_key_value("brim_type", new ConfigOptionEnum<BrimType>(btNoBrim));
+        ModelVolume* flange_volume = edit.object->add_volume(std::move(flange), ModelVolumeType::MODEL_PART, false);
+        flange_volume->name = "OpenAnchor flange";
+        flange_volume->config.set_key_value("extruder", new ConfigOptionInt(main_slot));
+        ModelVolume* anchor_volume = edit.object->add_volume(std::move(anchor), ModelVolumeType::MODEL_PART, false);
+        anchor_volume->name = "OpenAnchor anchor + clamp";
+        anchor_volume->config.set_key_value("extruder", new ConfigOptionInt(anchor_slot));
+        edit.record.generated_volume_ids = {flange_volume->id(), anchor_volume->id()};
+    }
+    edit.object->invalidate_bounding_box();
+    return edit;
+}
+
+} // namespace Slic3r::anchor_plate
