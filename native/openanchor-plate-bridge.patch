+#include "slic3r/plugin/host/AnchorPlateEdit.hpp"
+
+#include <limits>
+#include <cstddef>
+#include <string>
+#include <utility>
+
+using namespace Slic3r;
+
+namespace {
+ModelObject* add_source(Model& model)
+{
+    ModelObject* object = model.add_object("Original", "", make_cube(20., 20., 10.));
+    object->add_instance();
+    return object;
+}
+
+anchor_plate::Target target_for(const ModelObject& object)
+{
+    anchor_plate::Target target;
+    target.object_id = object.id();
+    target.source_volume_id = object.volumes.front()->id();
+    return target;
+}
+
+anchor_plate::StagedEdit apply(const ModelObject& object, anchor_plate::Target target)
+{
+    return anchor_plate::stage(object, std::move(target), false,
+        make_cube(25., 25., .6), make_cube(30., 30., 1.), 1, 2);
+}
+}
+
+TEST_CASE("Applying an anchor stages two parts without changing the live source", "[AnchorPlateEdit][Regression]")
+{
+    Model model;
+    const ModelObject* source = add_source(model);
+    const ModelObject* other = add_source(model);
+    const auto source_id = source->volumes.front()->id();
+    const auto instance_id = source->instances.front()->id();
+    auto edit = apply(*source, target_for(*source));
+    REQUIRE(source->volumes.size() == 1);
+    CHECK_FALSE(source->volumes.front()->config.has("extruder"));
+    CHECK_FALSE(source->config.has("brim_type"));
+    CHECK(model.objects[1] == other);
+    REQUIRE(edit.object->volumes.size() == 3);
+    CHECK(edit.object->id() == source->id());
+    CHECK(edit.object->volumes.front()->id() == source_id);
+    CHECK(edit.object->instances.front()->id() == instance_id);
+    CHECK(edit.object->get_model() == nullptr);
+    CHECK(edit.object->volumes[0]->config.extruder() == 1);
+    CHECK(edit.object->volumes[1]->config.extruder() == 1);
+    CHECK(edit.object->volumes[2]->config.extruder() == 2);
+    CHECK(edit.object->config.opt_serialize("brim_type") == ConfigOptionEnum<BrimType>(btNoBrim).serialize());
+    CHECK_FALSE(edit.record.original_extruder.has_value());
+    CHECK_FALSE(edit.record.original_brim.has_value());
+}
+
+TEST_CASE("Updating replaces only the expected generated parts and restoring preserves inheritance", "[AnchorPlateEdit][Regression]")
+{
+    Model model;
+    const ModelObject* source = add_source(model);
+    const auto source_id = source->volumes.front()->id();
+    auto first = apply(*source, target_for(*source));
+    auto second = apply(*first.object, first.record);
+    REQUIRE(second.object->volumes.size() == 3);
+    CHECK(second.object->volumes.front()->id() == source_id);
+    CHECK(second.record.generated_volume_ids[0] != first.record.generated_volume_ids[0]);
+    CHECK(second.record.generated_volume_ids[1] != first.record.generated_volume_ids[1]);
+    auto restored = anchor_plate::stage(*second.object, second.record, true);
+    REQUIRE(restored.object->volumes.size() == 1);
+    CHECK(restored.object->volumes.front()->id() == source_id);
+    CHECK_FALSE(restored.object->volumes.front()->config.has("extruder"));
+    CHECK_FALSE(restored.object->config.has("brim_type"));
+    CHECK(restored.record.generated_volume_ids.empty());
+    // A record from before an Undo cannot remove a newer pair of parts.
+    CHECK_THROWS(apply(*second.object, first.record));
+}
+
+TEST_CASE("Restoring retains explicit original settings and mirrored placement", "[AnchorPlateEdit][Regression]")
+{
+    Model model;
+    ModelObject* source = add_source(model);
+    source->volumes.front()->config.set_key_value("extruder", new ConfigOptionInt(3));
+    source->config.set_key_value("brim_type", new ConfigOptionEnum<BrimType>(btOuterOnly));
+    Transform3d transform = Transform3d::Identity();
+    transform.linear()(0, 0) = -2.;
+    transform.translation() = Vec3d(100., 80., 0.);
+    source->instances.front()->set_transformation(Geometry::Transformation(transform));
+    const Transform3d volume_transform = source->volumes.front()->get_transformation().get_matrix();
+    auto edit = apply(*source, target_for(*source));
+    CHECK(edit.object->instances.front()->get_transformation().get_matrix().matrix().isApprox(transform.matrix()));
+    TriangleMesh world = edit.object->volumes[1]->mesh();
+    world.transform(transform, true);
+    CHECK(world.bounding_box().min.isApprox(Vec3d::Zero(), 1e-5));
+    CHECK(world.bounding_box().max.isApprox(Vec3d(25., 25., .6), 1e-5));
+    auto restored = anchor_plate::stage(*edit.object, edit.record, true);
+    CHECK(restored.object->volumes.front()->config.extruder() == 3);
+    CHECK(restored.object->config.opt_serialize("brim_type") == source->config.opt_serialize("brim_type"));
+    CHECK(restored.object->volumes.front()->get_transformation().get_matrix().matrix().isApprox(volume_transform.matrix()));
+    CHECK(restored.object->instances.front()->get_transformation().get_matrix().matrix().isApprox(transform.matrix()));
+}
+
+TEST_CASE("Unknown or changed parts and instances are rejected before staging", "[AnchorPlateEdit][Regression]")
+{
+    Model model;
+    ModelObject* source = add_source(model);
+    auto target = target_for(*source);
+    SECTION("multiple instances") {
+        source->add_instance();
+        CHECK_THROWS(apply(*source, target));
+    }
+    SECTION("unknown multipart object") {
+        source->add_volume(make_cube(1., 1., 1.));
+        CHECK_THROWS(apply(*source, target));
+    }
+    SECTION("stale source ID") {
+        target.source_volume_id = ObjectID(std::numeric_limits<size_t>::max());
+        CHECK_THROWS(apply(*source, target));
+    }
+    SECTION("renamed generated volume") {
+        auto edit = apply(*source, target);
+        edit.object->volumes[1]->name = "User part";
+        CHECK_THROWS(apply(*edit.object, edit.record));
+        CHECK(edit.object->volumes.size() == 3);
+    }
+    SECTION("duplicate generated IDs") {
+        auto edit = apply(*source, target);
+        edit.record.generated_volume_ids[1] = edit.record.generated_volume_ids[0];
+        CHECK_THROWS(anchor_plate::stage(*edit.object, edit.record, true));
+    }
+}
+
+TEST_CASE("Malformed anchor meshes are rejected before native mesh construction", "[AnchorPlateEdit][Regression]")
+{
+    auto mesh = its_make_cube(10., 10., 1.);
+    SECTION("non-finite vertex") { mesh.vertices[0][0] = std::numeric_limits<float>::infinity(); }
+    SECTION("invalid index") { mesh.indices[0][0] = int(mesh.vertices.size()); }
+    SECTION("degenerate triangle") { mesh.indices[0][1] = mesh.indices[0][0]; }
+    SECTION("open edge") { mesh.indices.pop_back(); }
+    SECTION("reversed face") { std::swap(mesh.indices[0][0], mesh.indices[0][1]); }
+    CHECK_THROWS(anchor_plate::checked_mesh(std::move(mesh)));
+}
